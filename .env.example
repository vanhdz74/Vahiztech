# ==============================================================================
# KEYCLOAK & POSTGRESQL MULTI-TENANT IAM ENVIRONMENT CONFIGURATION
# ==============================================================================

# PostgreSQL 16 Alpine Database Configuration
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=keycloak_secure_pass_2026
POSTGRES_PORT=5432

# Keycloak Bootstrap Admin Credentials (Master Realm)
KEYCLOAK_ADMIN=admin
