{
  "id": "ecosystem-realm",
  "realm": "ecosystem-realm",
  "displayName": "Ecosystem Multi-Tenant IAM",
  "displayNameHtml": "<b>Ecosystem</b> Multi-Tenant IAM",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 604800,
  "roles": {
    "realm": [
      {
        "name": "org_admin",
        "description": "Tenant Organization Administrator - Quản trị viên Tenant",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "org_member",
        "description": "Tenant Organization Member - Thành viên tiêu chuẩn của Tenant",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "individual_user",
        "description": "Individual / B2C User - Người dùng độc lập không thuộc Tổ chức",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": [
    "individual_user"
  ],
  "clientScopes": [
    {
      "name": "tenant-info",
      "description": "Custom Scope nhúng claims Multi-Tenancy (tenant_id, licenses, roles) vào token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "gui.order": "1"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "licenses",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "licenses",
            "claim.name": "licenses",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "realm-roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
