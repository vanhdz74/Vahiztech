{
  "id": "ecosystem-realm",
  "realm": "ecosystem-realm",
  "displayName": "Vahiztech Ecosystem Hub & IAM",
  "displayNameHtml": "<b>Vahiztech</b> Ecosystem Hub & IAM",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": false,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 86400,
  "ssoSessionMaxLifespan": 604800,
  "roles": {
    "realm": [
      {
        "name": "ecosystem_super_admin",
        "description": "Vahiztech Ecosystem Super Admin - Quản trị viên cấp cao nhất hệ sinh thái Vahiztech Hub",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "org_admin",
        "description": "Tenant Organization Administrator - Quản trị viên Tenant / Khách hàng doanh nghiệp",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "org_member",
        "description": "Tenant Organization Member - Thành viên nhân sự / Học viên của Tổ chức",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "individual_user",
        "description": "Individual User / Free Tier - Người dùng cá nhân độc lập",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "defaultRoles": [
    "individual_user"
  ],
  "clientScopes": [
    {
      "name": "tenant-info",
      "description": "Custom Scope nhúng claims Multi-Tenancy (tenant_id, licenses, roles) vào token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "gui.order": "1"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "false",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "licenses",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "licenses",
            "claim.name": "licenses",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true",
            "aggregate.attrs": "false"
          }
        },
        {
          "name": "realm-roles-claim",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "multivalued": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "roles",
    "web-origins",
    "tenant-info"
  ],
  "defaultOptionalClientScopes": [
    "offline_access",
    "address",
    "phone",
    "microprofile-jwt"
  ],
  "clients": [
    {
      "clientId": "vahiztech-hub",
      "name": "Vahiztech App Store & Central Hub Portal",
      "description": "Cổng Trung tâm Vahiztech - Chợ ứng dụng SaaS và Trung tâm điều hành SSO (như Google Workspace Hub)",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "rootUrl": "http://localhost:3000",
